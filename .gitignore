# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# native (Capacitor)
# The iOS/Android projects themselves ARE committed — they hold real
# configuration (Info.plist, AndroidManifest, icons). What's excluded is
# everything regenerated by `cap sync` or a native build, above all the copied
# web bundle, which would otherwise land thousands of minified files in git on
# every single build.
/android/app/src/main/assets/public/
/android/app/src/main/assets/capacitor.config.json
/android/app/src/main/assets/capacitor.plugins.json
/android/.gradle/
/android/build/
/android/app/build/
/android/local.properties
/android/capacitor-cordova-android-plugins/
/ios/App/App/public/
/ios/App/App/capacitor.config.json
/ios/App/Pods/
/ios/App/build/
/ios/DerivedData/
/ios/capacitor-cordova-ios-plugins/

# signing material — never commit these
*.keystore
*.jks
keystore.properties
*.p8
*.p12
*.mobileprovision
google-services.json
GoogleService-Info.plist

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*.local
.claude/settings.local.json
